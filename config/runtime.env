# Local Claude Code envelope shared by the HarnessDock runtime and direct Terminal use.
CLAUDE_NATIVE_CONFIG_DIR=/data/CoordExp/.claude
CLAUDE_CONFIG_DIR=/data/CoordExp/.claude
CLAUDE_CODE_DISABLE_AUTO_MEMORY=0
CONDA_EXE=/root/miniconda3/bin/conda
CODEX_HARNESSDOCK_CLAUDE_BIN=/root/.nvm/versions/node/v22.22.0/bin/claude
http_proxy=http://127.0.0.1:9090
https_proxy=http://127.0.0.1:9090
all_proxy=http://127.0.0.1:9090
HTTP_PROXY=http://127.0.0.1:9090
HTTPS_PROXY=http://127.0.0.1:9090
ALL_PROXY=http://127.0.0.1:9090
no_proxy=127.0.0.1,localhost
NO_PROXY=127.0.0.1,localhost

# Operator-owned OpenCode loopback Server. Optional Basic-auth credentials
# (OPENCODE_SERVER_USERNAME / OPENCODE_SERVER_PASSWORD) are never tracked
# here; they are read only from the inherited operator process environment.
PI_CODING_AGENT_DIR=/data/CoordExp/.pi/agent
OPENCODE_EXECUTABLE=/root/.opencode/bin/opencode
OPENCODE_SERVER_URL=http://127.0.0.1:4096
XDG_CONFIG_HOME=/data/CoordExp/.config
XDG_DATA_HOME=/data/CoordExp/.local/share
XDG_CACHE_HOME=/data/CoordExp/.cache
XDG_STATE_HOME=/data/CoordExp/.local/state

# Optional L0 wake publisher for descriptor-bound Agent turns.
CODEX_HARNESSDOCK_WAKE_PUBLISHER_BIN=/root/miniconda3/envs/ms/bin/codex-wake-me-up
CODEX_HARNESSDOCK_WAKE_RUNTIME_ROOT=/data/CoordExp/.codex/runtime/codex-wake-me-up
