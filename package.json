{
  "name": "codex-harnessdock-runtime",
  "version": "0.25.5",
  "description": "HarnessDock for Codex is an unofficial third-party durable Claude Agent runtime; it is not affiliated with or endorsed by OpenAI.",
  "private": true,
  "type": "module",
  "author": {
    "name": "Pein2017",
    "url": "https://github.com/Pein2017"
  },
  "bin": {
    "codex-harnessdock-runtime": "plugins/codex-harnessdock/bootstrap/harnessdock-runtime.mjs"
  },
  "license": "Apache-2.0",
  "files": [
    "plugins/codex-harnessdock",
    "config",
    "LICENSE",
    "NOTICE",
    "README.md",
    "package.json",
    "runtime"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "install:local": "node scripts/local-plugin-install.mjs --initial",
    "refresh:local": "node scripts/local-plugin-install.mjs --refresh-only",
    "release:local": "node scripts/update-plugin-cachebuster.mjs && node scripts/local-plugin-install.mjs --refresh-only",
    "promote:local": "node scripts/promote-local.mjs",
    "adopt:identity": "node scripts/adopt-plugin-identity.mjs",
    "smoke:release": "node scripts/release-smoke.mjs",
    "lint": "eslint runtime scripts tests/runtime",
    "typecheck": "tsc -p tsconfig.json",
    "test": "CODEX_HARNESSDOCK_RUNTIME_CHECKOUT= CODEX_HARNESSDOCK_RUNTIME_SOURCE_ROOT= CODEX_HARNESSDOCK_RUNTIME_ENV_FILE=$PWD/config/runtime.env node --import ./tests/runtime/fixtures/pinned-data-root.mjs --test tests/runtime/*.test.mjs",
    "test:focus": "CODEX_HARNESSDOCK_RUNTIME_CHECKOUT= CODEX_HARNESSDOCK_RUNTIME_SOURCE_ROOT= CODEX_HARNESSDOCK_RUNTIME_ENV_FILE=$PWD/config/runtime.env node --import ./tests/runtime/fixtures/pinned-data-root.mjs --test",
    "test:integration": "CODEX_HARNESSDOCK_RUNTIME_CHECKOUT= CODEX_HARNESSDOCK_RUNTIME_SOURCE_ROOT= CODEX_HARNESSDOCK_RUNTIME_ENV_FILE=$PWD/config/runtime.env node --import ./tests/runtime/fixtures/pinned-data-root.mjs --test tests/runtime-integration/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencode-ai/sdk": "1.18.18",
    "zod": "4.4.3"
  }
}
