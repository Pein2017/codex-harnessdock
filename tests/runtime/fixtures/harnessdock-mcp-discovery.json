            "description": "Required topology: leaf runs the task itself; native_orchestrator is admitted only by a Harness whose route proves it."
          },
          "write": {
            "type": "boolean",
            "description": "Required behavioral authority: false is read/review-only; true permits task-scoped writes. Process access is unchanged."
